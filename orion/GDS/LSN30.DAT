scr("15",1,"                        BAGGAGE POLICY       EN  24SEP22 0723Z            ")
scr("15",1," ***CHECKED BAGGAGE ALLOWANCES****************************************    ")
scr("15",1,"                                                                          ")
scr("15",1," I N T.  P I E C E  CONCEPT (TO/FROM USA & CANADA)                        ")
scr("15",1," THE PIECE CONCEPT APPLIES FOR TRAVEL FROM/TO USA & CANADA TO THE FIRST   ")
scr("15",1," STOPOVER POINT OUTSIDE USA/CANADA OR FROM LAST STOPOVER POINT BEFORE     ")
scr("15",1," RETURNING TO THE USA/CANADA. IT ALSO APPLIES MEXICO/SPAIN/MEXICO.        ")
scr("15",1,"                                                                          ")
scr("15",1," ALL CLASSES OF SVC:       2 PCS / MAX WEIGHT PER PIECE OF 70 LB (32 KGS) ")
scr("15",1,"                           EXCEPT CANADA TO MEXICO MAX WEIGHT 23 KGS EACH ")
scr("15",1,"                                                                          ")
scr("15",1," GRAND/PREFERENCE CLASS:   MAX SUM OF LENGTH, WIDTH, AND HEIGHT           ")
scr("15",1,"                           62 IN (158 CMS) PER PIECE. TOTAL NOT MORE      ")
scr("15",1,"                           THAN 124 IN (316 CMS) FOR BOTH PIECES.         ")
scr("15",2,"This page describes the airline's checked baggage allowance based on the")
scr("15",2,"piece concept.")
scr("15",2,"<PgDn>")
scr("15",5,"PD")
