scr("15",2,"departing at 1615. He also has a confirmed reservation on IB 4216")
scr("15",2,"departing at 0905. The waitlisted segment is now confirmed. Change the")
scr("15",2,"segment status.")
scr("15",11,"RP/BRUSN2442/BRUSN2442         6464FP   19SEP /1142Z   G4CP2E")
scr("15",8,"LECRIX/MICHEL MR")
scr("15",6,"  2   TP 671 S 26SEP 2 BRULIS HK1               1330  1615 ")
