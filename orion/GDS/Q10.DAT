scr("5",2,"   identification code MADIB0230.")
scr("5",5,"TKTL23OCT/MADIB0230")
scr("6",2,"7. Make the entry to arrange ticketing for 14 August.")
scr("6",5,"TKTL14AUG")
scr("7",2,"8. Input the entry to mail tickets on 26 May.")
scr("7",5,"TKMA26MAY")
