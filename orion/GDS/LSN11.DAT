scr("13",2,"Sell 2 seats M class on RK 401.")
scr("13",5,"SS2M3")
scr("14",6,"  RK 401 M 22AUG 7 STNCIA SS2            1305  1625   320   0")
scr("14",2,"The passengers are Mr. S. Thomas and Mrs. D. Thomas. Input the")
scr("14",2,"passenger names.")
scr("14",5,"NM2THOMAS/SMR/DMRS")
scr("14",5,"NM2THOMAS/S MR/D MRS")
scr("14",5,"NM2THOMAS/S/D")
scr("15",6,"  RK 401 M 22AUG 7 STNCIA SS2            1305  1625   320   0")
scr("15",2,"Now input the London home phone 45 31268765.")
scr("15",5,"APLON -H")
scr("16",2,"Arrange ticketing for 19th July.")
scr("16",6,"  RK 401 M 22AUG 7 STNCIA SS2            1305  1625   320   0")
scr("16",5,"TKTL19JUL")
scr("17",6,"  RK 401 M 22AUG 7 STNCIA SS2            1305  1625   320   0")
scr("17",2,"The reservation was received from Mr. Thomas. Input the received-from")
scr("17",2,"element.")
scr("17",5,"RFP")
scr("18",2,"This PNR now includes a received-from element, name elements, an itinerary,")
scr("18",2,"a contact element, and a ticketing element. In the next lesson, you will")
scr("18",2,"learn how to end the transaction and store the reservation. Ignore the")
scr("18",2,"the transaction.")
scr("18",6,"  RK 401 M 22AUG 7 STNCIA SS2            1305  1625   320   0")
scr("18",5,"IG")
scr("19",1,"IGNORED")
scr("19",2,"You have reached the end of the lesson. Repeat this lesson until")
scr("19",2,"you can finish without requesting help.")
scr("19",2,"<PgDn>")
scr("19",5,"PD")
