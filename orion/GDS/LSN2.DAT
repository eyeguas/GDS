scr("18",2,"A departure time may be specified as follows:")
scr("18",2," ")
scr("18",2,"                          AN22AUGLYSROM800A^")
scr("18",2," ")
scr("18",2,"When this entry is input, GDS will search for the flights departing")
scr("18",2,"within one hour of 800 am. Input this entry now.")
scr("18",5,"AN22AUGLYSROM0800")
scr("18",5,"AN22AUGLYSROM800A")
scr("18",5,"AN22AUGLYSROM8A")
