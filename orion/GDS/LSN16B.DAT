scr("5",1,"000  OS/LH3566 M 28APR 2 FRAFCO LK1           1645  1835/NN")
scr("5",1,"000  OS/LH3509 M  3MAY 7 FCOFRA LK1           1245  1450/NN")
scr("5",1,"000  RF-MRCOLVITO CR-FRALH2443 AS 1661AM 12APR/1352Z")
scr("5",2,"The transaction number 000^ indicates the original PNR creation. The history")
scr("5",2,"code OS^ indicates an original segment. The third line shows the received-")
scr("5",2,"from information, the office which created the PNR, and the agent's duty ")
scr("5",2,"code and identification code. The creation date and time are shown at the")
scr("5",2,"end of the third line. ")
scr("5",2,"<PgDn>")
scr("5",5,"PD")
scr("6",2,"The following are examples of codes which may appear in a PNR history:")
scr("6",2," ")
scr("6",2,"        AN^  Added name element          CT^  Changed ticketing element")
scr("6",2,"        AP^  Added contact element       DL^  Deleted element")
scr("6",2,"        AT^  Added ticketing element     OS^  Original air segment")
scr("6",2,"        CN^  Changed name element        SA^  Added SSR           ")
scr("6",2,"        CP^  Changed contact element     XN^  Cancelled name element")
scr("6",2," ")
scr("6",2,"Which code would indicate that a name element was added to the PNR?")
scr("6",5,"AN")
