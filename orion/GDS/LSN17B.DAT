scr("2",1,"END OF TRANSACTION COMPLETE - D4FR3W")
scr("2",2,"The following are examples of entries to cancel multiple PNR elements:")
scr("2",2," ")
scr("2",2,"            XE5,8^               Cancel elements 5 and 8")
scr("2",2,"            XE3-5^               Cancel elements 3, 4, and 5")
scr("2",2,"            XE4,6-8^             Cancel elements 4, 6, 7, and 8")
scr("2",2,"            XI^                  Cancel entire itinerary")
scr("2",2," ")
scr("2",2,"Note in the third example the use of a comma (,) and a dash (-) in the same")
scr("2",2,"entry. What entry would cancel elements 5 and elements 7 through 10? ")
scr("2",5,"XE5,7-10")
scr("2",5,"XE5,7,8,9,10")
scr("2",5,"XE10,9,8,7,5")
scr("3",2,"Retrieve the PNR for the surname Beauchamp.")
scr("3",5,"RT/BEAUCHAMP")
