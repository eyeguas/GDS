scr("0",2,"1. Make the entry to show that the PNR is completely ticketed.")
scr("0",5,"TKOK")
scr("1",2,"2. Input a ticketing deadline for 17 March.")
scr("1",5,"TKTL17MAR")
scr("2",2,"3. Input the entry to indicate a prepaid ticket.")
scr("2",5,"TKPT")
scr("3",2,"4. Make the entry to arrange ticketing for 22 April.")
scr("3",5,"TKTL22APR")
scr("4",2,"5. Input the entry to mail tickets on 23 July.")
scr("4",5,"TKMA23JUL")
