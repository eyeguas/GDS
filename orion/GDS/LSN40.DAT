scr("0",22,"            MISCELLANEOUS ENTRIES")
scr("0",2," After finishing this lesson, you will be able to...")
scr("0",2," ")
scr("0",2,"   [ display flight information.         ")
scr("0",2,"   [ display minimum connecting times.")
scr("0",2,"   [ use calculator entries to perform arithmetic.")
scr("0",2,"   [ display currency exchange rates and convert currencies.")
scr("0",2,"<PgDn>")
scr("0",5,"PD")
scr("1",2,"The transaction code DO^ is used to display flight information, as follows:")
scr("1",2," ")
scr("1",2,"                              DO^AF2421/18SEPAMSCDG")
scr("1",2," ")
scr("1",2,"This example will display operational data for Air France 2421 on 18 ")
scr("1",2,"September from Amsterdam to Charles de Gaulle. The applicable airport")
scr("1",2,"code must be input for a multi-airport city. Make the entry to display")
scr("1",2,"information for LH 5380 on 26 April from Duesseldorf to Fiumicino.")
scr("1",5,"DOLH5380/26APRDUSFCO")
scr("2",2,"Display flight information for SR 882 on 24 October from Zurich to Brussels.")
scr("2",5,"DOSR882/24OCTZRHBRU")
scr("3",1,"  SR 0882/24OCT      MO   CLS/MEAL                      EQP HR/MIN")
scr("3",1,"  ZRH         0740        C/C   W/C   Y/C   M/C   L/C   M80")
scr("3",1,"                          K/C")
scr("3",1,"  BRU 0900                                                    1/20")
scr("3",1,"  COMMENTS-")
scr("3",1,"  1.ZRH BRU -   99 FLT DEPARTS TERMINAL A")
scr("3",1," ")
scr("3",1,"  CONFIGURATIONS- C 40   M 140")
scr("3",2,"The flight in this example departs from Zurich at 0740. The middle columns")
scr("3",2,"show the classes of service and the type of meal served in each class. The ")
scr("3",2,"meal code C^ indicates continental breakfast. The equipment code is ")
scr("3",2,"displayed on the far right. The arrival point and arrival time are also ")
scr("3",2,"displayed. The flight in this example will arrive in Brussels at 0900. ")
scr("3",2,"<PgDn>")
scr("3",5,"PD")
scr("4",2,"Comments about the flight may be displayed below the flight details. The")
scr("4",2,"number before the text is a predefined message number. The last line of")
scr("4",2,"the display shows the seating configuration. This flight has 2 cabins:")
scr("4",2,"C class with 40 seats and M class with 140 seats. What entry will display")
scr("4",2,"flight information for LH 401 from John F Kennedy to Frankfurt on 15 August?")
scr("4",5,"DOLH401/15AUGJFKFRA")
scr("5",2,"The transaction code DM^ is used to display minimum connecting times, as")
scr("5",2,"follows:                       ")
scr("5",2,"                                   DMATH^")
scr("5",2,"                             ")
scr("5",2,"This example will display minimum connecting times at the Athens airport.")
scr("5",2,"Make the entry to display minimum connecting times at the Miami airport.")
scr("5",5,"DMMIA")
scr("5",5,"DM MIA")
scr("6",2,"Make the correct entry to display minimum connecting times in Nice.")
scr("6",5,"DMNCE")
scr("6",5,"DM NCE")
scr("7",1,"NCE  STANDARD MINIMUM CONNECTING TIMES                           ")
scr("7",1,"NCE-NCE      FROM      -             TO                          ")
scr("7",1,"CC NNNN-RRRR ORGN EQPTM-CC NNNN-RRRR DEST EQPTM D/D D/I I/D I/I  ")
scr("7",1,"                       -                        020 100 100 100  ")
scr("7",1,"                      1-                      1 035 040 040 045  ")
scr("7",1,"                      1-                      2 100 100 100 100  ")
scr("7",1,"                      2-                      1 100 100 100 100  ")
scr("7",1,"                      2-                      2 035 045 045 045  ")
scr("7",1,"CK SPECIFIC CARRIER FOR EXCEPTIONS TO STANDARD CONNECTING TIMES  ")
scr("7",1,"PRECLEARANCE MAY APPLY                                           ")
scr("7",2,"In this example, the minimum time for a domestic-to-domestic (D/D)")
scr("7",2,"connection from terminal 1 to terminal 2 is 1:00. ")
scr("7",2,"<PgDn>")
scr("7",5,"PD")
scr("8",2,"What is the minimum time for an international-to-domestic (I/D) connection")
scr("8",2,"within terminal 1?")
scr("8",5,"0:40")
scr("8",5,"040")
scr("8",5,"40")
scr("9",2,"The following entries may be used to display minimum connecting times for a")
scr("9",2,"specific airport, a multi-airport city, and for inter-airport connections:")
scr("9",2," ")
scr("9",2,"              DMJFK^              Specific airport")
scr("9",2,"              DMNYC^              Multi-airport city ")
scr("9",2,"              DMJFK-LGA^          Inter-airport connections")
scr("9",2," ")
scr("9",2,"What entry will display minimum connecting times at London Heathrow Airport?")
scr("9",5,"DMLHR")
scr("9",5,"DM LHR")
scr("10",2,"Assume a passenger will arrive at London Gatwick and transfer to a")
scr("10",2,"connecting flight at London Heathrow. Make the correct entry to display ")
scr("10",2,"the minimum connecting times.")
scr("10",5,"DMLGW-LHR")
scr("10",5,"DM LGW-LHR")
scr("11",1,"DMLGW-LHR                                                        ")
scr("11",1,"LGW  STANDARD MINIMUM CONNECTING TIMES                           ")
scr("11",1,"LGW-LHR      FROM      -             TO                          ")
scr("11",1,"CC NNNN-RRRR ORGN EQPTM-CC NNNN-RRRR DEST EQPTM D/D D/I I/D I/I  ")
scr("11",1,"                       -                        230 230 230 230  ")
scr("11",1,"CK SPECIFIC CARRIER FOR EXCEPTIONS TO STANDARD CONNECTING TIMES  ")
scr("11",1,"PRECLEARANCE MAY APPLY                                           ")
scr("11",2,"The following will display connecting times for a specific arrival terminal,")
scr("11",2,"for a specific departure teriminal, and for specific arrival and departure")
scr("11",2,"terminals:")
scr("11",2,"             DMCDG2A^           Specific arrival terminal")
scr("11",2,"             DMCDG-2C^          Specific departure terminal         ")
scr("11",2,"             DMCDG2A-2C^        Specific arrival and departure terminals")
scr("11",2," ")
scr("11",2,"What entry will display the minimum connecting time at London Heathrow from")
scr("11",2,"terminal 4 to terminal 3?")
scr("11",5,"DMLHR4-3")
scr("11",5,"DM LHR4-3")
scr("12",2,"Assume a passenger will arrive at Charles de Gaulle terminal 2A and transfer")
scr("12",2,"to a connecting flight at terminal 2C. Make the correct entry to display the")
scr("12",2,"minimum connecting times.")
scr("12",5,"DMCDG2A-2C")
scr("12",5,"DM CDG2A-2C")
scr("13",2,"The following will display connecting times for an inbound carrier, for")
scr("13",2,"inbound and outbound carriers, and for inter-airport connections:")
scr("13",2," ")
scr("13",2,"        DMBD/LHR^            Inbound carrier ")
scr("13",2,"        DMBD/CDG/AF^         Inbound and outbound carriers")
scr("13",2,"        DMAF/CDG-ORY/LH^     Inter-airport inbound and outbound carriers")
scr("13",2,"         ")
scr("13",2,"What entry will display minimum connecting times from Sundair to")
scr("13",2,"United Airlines at Heathrow (London)?")
scr("13",5,"DMSR/LHR/UA")
scr("13",5,"DM SR/LHR/UA")
scr("14",2,"Assume a passenger will arrive in Dusseldorf on a Lufthansa flight and")
scr("14",2,"transfer to a Aer Lingus flight. Make the correct entry to display")
scr("14",2,"the minimum connecting times.")
scr("14",5,"DMLH/DUS/EI")
scr("14",5,"DM LH/DUS/EI")
scr("15",1,"DMLH/DUS/EI                                                     ")
scr("15",1,"DUS  STANDARD MINIMUM CONNECTING TIMES                          ")
scr("15",1,"DUS-DUS      FROM      -             TO                         ")
scr("15",1,"CC NNNN-RRRR ORGN EQPTM-CC NNNN-RRRR DEST EQPTM D/D D/I I/D I/I ")
scr("15",1,"                       -                        115 115 115 115 ")
scr("15",1,"                                                                ")
scr("15",1,"DUS-QDU      FROM      -             TO                         ")
scr("15",1,"CC NNNN-RRRR ORGN EQPTM-CC NNNN-RRRR DEST EQPTM D/D D/I I/D I/I ")
scr("15",1,"                       -                        300 300 300 300 ")
scr("15",1,"CK SPECIFIC CARRIER FOR EXCEPTIONS TO STANDARD CONNECTING TIMES ")
scr("15",1,"PRECLEARANCE MAY APPLY                                          ")
scr("15",2,"The transaction code DF^ is used to perform calculations, as follows:")
scr("15",2," ")
scr("15",2,"                               DF145;299^")
scr("15",2,"                                               ")
scr("15",2,"This example would be used to add 145 plus 299. Input this entry.")
scr("15",5,"DF145;299")
scr("15",5,"DF299;145")
scr("16",1,"444")
scr("16",2,"The following are examples of entries to add, subtract, multiply, and divide:")
scr("16",2," ")
scr("16",2,"                 DF1654;973^         Add 1654 plus 973")
scr("16",2,"                 DF571-126^          Subtract 126 from 571 ")
scr("16",2,"                 DF1872*11^          Multiply 1872 times 11")
scr("16",2,"                 DF2262/12^          Divide 2262 by 12")
scr("16",2," ")
scr("16",2,"Study the examples, then make the entry to divide 6071 by 5.")
scr("16",5,"DF6071/5")
scr("16",5,"DF 6071/5")
scr("17",1,"1 214.2")
scr("17",2,"Make the entry to subtract 543 from 1877.")
scr("17",5,"DF1877-543")
