scr("7",2,"When fare notes are requested by line number, the applicable rules are ")
scr("7",2,"displayed based on the departure date in the fare display. A typical fare")
scr("7",2,"notes display may consist of several pages. The entry MD^ is used display")
scr("7",2,"the next page. Input this entry now.")
scr("7",5,"MD")
scr("8",1,"14.CONSTRUCTIONS/COMBINATIONS                               ")
scr("8",1,"    FARES MAY NOT BE COMBINED WITH ADD-ONS.                 ")
scr("8",1,"    FARES MAY BE COMBINED END TO END PROVIDED TRAVEL IS VIA ")
scr("8",1,"    THE POINT OF COMBINATION.                               ")
scr("8",1,"   OPEN JAWS/ROUND TRIPS/CIRCLE TRIPS                       ")
scr("8",1,"     THESE FARES MAY BE COMBINED ON A HALF ROUND TRIP BASIS ")
scr("8",1,"     TO FORM SINGLE OR DOUBLE OPEN JAWS/ROUND TRIPS/CIRCLE  ")
scr("8",1,"     TRIPS.                                                 ")
scr("8",1,"    PROVIDED -                                              ")
scr("8",1,"      COMBINATIONS ARE PERMITTED WITH FARES GOVERNED BY ANY ")
scr("8",1,"      RULE IN ANY TARIFF.                                   ")
scr("8",1,"21.AGENTS DISCOUNTS                                         ")
scr("8",1,"   PERMITTED                                                ")
scr("8",2,"Each paragraph of the IATA fare notes is numbered. In this example, the rule")
scr("8",2,"pertaining to stopovers is paragragh 11, and the permitted routing is ")
scr("8",2,"paragraph 12.")
scr("8",2,"<PgDn>")
scr("8",5,"PD")
