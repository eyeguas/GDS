scr("18",1,"            T9                                                                ")
scr("18",1," 3  TP 705  C7 Y7 M7 L7 V7        OPO   LIS   1450   1555   0*32S             ")
scr("18",1,"    NI 809  F4 C4 Y4 H4 M4        LIS   BCN   1640   1730   0 100         3:40")
scr("18",1," 4  IB3102  C9 Y9 L9 W9 K9 Q9 V9 /OPO   LIS   1645   1755   0/M87             ")
