scr("1",1," CANCELLED BEFORE 6:00 PM, LOCAL HOTEL TIME, ON THE DAY OF     ")
scr("1",1," SCHEDULED ARRIVAL. THE REFUND WILL BE SENT TO THE PARTY       ")
scr("1",1," WHO ORIGINALLY PAID THE DEPOSIT OR PREPAYMENT. IN THE CASE    ")
scr("1",1," OF A VOUCHER, THE VOUCHER WILL BE RETURNED TO THE             ")
