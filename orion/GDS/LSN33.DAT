scr("7",1,"     -CHILDREN- 1 UNDER 14YRS FREE IN PARENTS ROOM.              ")
scr("7",1,"        2 IN ADJOINING ROOM PAY SINGLE RATE.                     ")
scr("7",1,"     -CREDIT CARDS- AMERICAN EXPRESS/CARTE BLANCHE/              ")
scr("7",1,"MORE")
scr("7",2,"The maximum room occupancy and policy information are also displayed. In")
scr("7",2,"this example, the earliest check-in time is 2 P.M., and the latest check-")
scr("7",2,"out time is 12 noon. Children under 14 years are permitted to stay free of")
scr("7",2,"of charge in the same room as their parents.")
scr("7",2,"<PgDn>")
scr("7",5,"PD")
