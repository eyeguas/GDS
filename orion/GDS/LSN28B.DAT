scr("1",2,"When the transaction is ended, the PNR is removed from the queue and the")
scr("1",2,"next PNR on the queue is displayed automatically. This PNR has no itinerary.")
scr("1",2,"The entry QN^ is used to remove a PNR from the current queue. Assume this ")
scr("1",2,"PNR does not need to be in the queue. Input the entry to remove the PNR.")
scr("1",11,"RP/PARAF2298/PARAF2298                2078JM  17OCT /1522Z  WGDF2L")
scr("1",8,"MARCHAND/RAYMOND MR")
scr("1",6,"  2 AP PAR 45 73 62 65-H")
scr("1",6,"  3 TK TL23OCT/PARAF2298")
scr("1",5,"QN")
scr("2",1,"KL")
scr("2",1,"RP/PARAF2298/PARAF2298                2412HF  21OCT /1602Z  WRKJ3G")
scr("2",1,"  1.ROBERT/ANDRE MR")
scr("2",1,"  2  AF1470 Y 23OCT 3 CDGFRA KL1    0835 2C 0855  1020    *1A/")
scr("2",1,"  3 AP PAR 44 38 74 35-H")
scr("2",1,"  4 TK TL22OCT/PARAF2298")
scr("2",2,"Whenever an agent ends, removes, or ignores a record, the next PNR on the")
scr("2",2,"queue is displayed automatically, unless there are no more PNRs on the ")
scr("2",2,"queue.")
scr("2",2,"<PgDn>")
scr("2",5,"PD")
scr("3",2,"The following entries are used to exit from the queue:")
scr("3",2," ")
scr("3",2,"            QI^         Ignore transaction/exit queue ")
scr("3",2,"            QF^         End transaction/exit queue ")
scr("3",2,"            QD^         Ignore transaction/move PNR to back")
scr("3",2," ")
scr("3",2,"Input the entry to ignore the transaction and exit the queue.")
scr("3",11,"RP/PARAF2298/PARAF2298                2412HF  21OCT /1602Z  WRKJ3G")
scr("3",8,"ROBERT/ANDRE MR")
scr("3",6,"  2  AF1470 Y 23OCT 3 CDGFRA KL1    0835 2C 0855  1020    *1A/")
scr("3",6,"  3 AP PAR 44 38 74 35-H")
scr("3",6,"  4 TK TL22OCT/PARAF2298")
scr("3",5,"QI")
scr("4",1,"IGNORED - OFF Q")
scr("4",2,"Queue 7 holds PNRs with segments that are affected by schedule changes.")
scr("4",2,"Assume you have signed on to this queue. What entry would be used to")
scr("4",2,"end the transaction and exit the queue?")
scr("4",5,"QF")
scr("5",2,"If a client is not available to reconfirm an itinerary, the transaction")
scr("5",2,"code QD^ may be used to delay the PNR until a specified time or date, as ")
scr("5",2,"follows:")
scr("5",2,"                  QD1300^        Delay PNR until 1300")
scr("5",2,"                  QD18MAR^       Delay PNR until 18 March ")
scr("5",2," ")
scr("5",2,"What entry would be used to delay a PNR until 1800?")
scr("5",5,"QD1800")
scr("6",2,"Assume you are signed onto a queue. You attempted to notify a client about")
scr("6",2,"a schedule change, but have been unable to contact the passenger. Which ")
scr("6",2,"entry should be used to delay the PNR until 24 July?")
scr("6",5,"QD24JUL")
scr("7",2,"Which entry would be used to delay a PNR until 2000?")
scr("7",5,"QD2000")
scr("8",2,"The transaction code QE^ is used to place a PNR on a numbered queue, as")
scr("8",2,"follows:")
scr("8",2,"                                     QE88^")
scr("8",2," ")
scr("8",2,"This entry will place the PNR on queue 88. What entry would be used to place")
scr("8",2,"a PNR on queue 27?")
scr("8",5,"QE27")
scr("9",2,"What entry would be used to place a retrieved PNR on queue 81?  ")
scr("9",5,"QE81")
scr("10",2,"Queue 3 is called the Option^ queue. The transaction code OP will place a ")
scr("10",2,"PNR on the Option queue, as follows:")
scr("10",2," ")
scr("10",2,"                          OP17APR/ISSUE^ TOUR^ VOUCHERS^")
scr("10",2," ")
scr("10",2,"Any free text may be typed after the date. What entry will place a PNR on")
scr("10",2,"the Option queue on 30 November with the text COLLECT^ DEPOSIT^?")
scr("10",5,"OP30NOV/COLLECT DEPOSIT")
scr("10",5,"OP30NOV/COLLECT DPST")
scr("11",2," A PNR may be sent to another office's Option queue, as follows:")
scr("11",2," ")
scr("11",2,"                        OPNCEAF2290/17APR/SEND^ BROCHURE^")
scr("11",2," ")
scr("11",2," The office identification code is typed before the date. Make the entry to ")
scr("11",2," place a PNR on queue 3 at office MADIB2440 on 31 August, with the text ")
scr("11",2," SEE^ REMARKS^.")
scr("11",5,"OPMADIB2440/31AUG/SEE REMARKS")
scr("11",5,"OPMADIB2440/31AUG/SEE RMKS")
scr("12",2,"Assume you want to place a PNR on the option queue for office FRALH0365 on ")
scr("12",2,"14 March, with the text ISSUE^ INVOICE^ . Make the entry to create the ")
scr("12",2,"option element.")
scr("12",5,"OPFRALH0365/14MAR/ISSUE INVOICE")
scr("12",5,"OPFRALH0365/14MAR/ISSUE INV")
