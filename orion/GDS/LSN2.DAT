scr("0",22,"             FLIGHT AVAILABILITY")
scr("0",2," After finishing this lesson, you will be able to...")
scr("0",2," ")
scr("0",2,"      [ display neutral availability for a specific date and city pair.")
scr("0",2,"      [ interpret the information in an availability display.")
scr("0",2,"      [ specify the departure time.")
scr("0",2,"<PgDn>")
scr("0",5,"PD")
scr("1",2,"The transaction code AN^ is input to obtain a neutral display of available")
scr("1",2,"flights for a specific date and city pair. For example, the following entry")
scr("1",2,"will display flights departing on 1 February from Salt Lake City to Dallas:")
scr("1",2," ")
scr("1",2,"                              AN1FEBSLCDFW^")
scr("1",2,"                     Date~~~~~~~~~~{   !")
scr("1",2,"                     City pair~~~~~~~~~{")    
scr("1",2," ")
scr("1",2,"Input this entry now.")
scr("1",5,"AN1FEBSLCDFW")
scr("2",1,"** GDS AVAILABILITY - AN **          241 MO 1FEB 0000")
scr("2",1," 1   AA1214  C9 Z2 Y9 S9 K9 H9 T9 /SLC 1 DFW 0 0600   0940   0/738       2:40")
scr("2",1,"             Q9 V9 X9 GR                                                     ")
scr("2",1," 2   AA1717  C9 Z9 V8 L7 H6 B0 G0 /SLC 1 DFW 0 0755   1137   0/738       2:42")
scr("2",1,"             K0 Q0 M0                                                        ")
scr("2",1," 3   AA2449  C9 Z9 V9 L9 H9 B9 G9 /SLC 1 DFW 0 0935   1316   0/738       2:41")
scr("2",1,"             K9 Q9 W9 M9                                                     ")
scr("2",1," 4   AA2928  C9 Z2 Y9 S9 K9 H9 T9 /SLC 1 DFW 0 1150   1529   0/738       2:39")
scr("2",1,"             Q9 V9 X9 GR                                                     ")
scr("2",1," 5   AA1929  C9 Z2 Y9 S9 K9 H9 T9 /SLC 1 DFW 0 1350   1731   0/738       2:41")
scr("2",1,"             Q9 V9 X9 GR                                                     ")
scr("2",1," 6   AA1924  C9 Z9 V9 L9 H9 B9 G9 /SLC 1 DFW 0 1535   1914   0/738       2:39")
scr("2",1,"             K9 Q9 W9 M9                                                     ")
scr("2",2,"If a city code is input for a multi-airport city, GDS will display")
scr("2",2,"flights for all local airports. Display availability for flights departing")
scr("2",2,"on 2 March from Madrid to Paris.")
scr("2",5,"AN2MARMADPAR")
scr("3",1," ** GDS AVAILABILITY - AN **          272 TU 2MAR 0000")
scr("3",1," 1   IB3402  C9 Y9 L9 W9 K9 Q9 V5 /MAD 4 ORY 1 0750   0950   0/320         2:00")
scr("3",1,"             T5                                                                ")
scr("3",1," 2   IB3436  C9 Z2 Y9 S9 K9 H9 T9 /MAD 4 ORY 1 0945   1145   0/320         2:00")
scr("3",1,"             Q9 V9 X9 GR                                                       ")
scr("3",1," 3   IB3406  D9 B9 L9 M9 V9       /MAD 4 ORY 1 1130   1330   0/319         2:00")
scr("3",1," 4   IB3442  D9 M9 L9 B9 K9 Q9 V9 /MAD 4 ORY 1 1445   1645   0/320         1:55")
scr("3",1," 5   AF8614  Y9 K9 Q9 T9 V9       /MAD 4 CDG 3 0725   0920   0/100         1:55")
scr("3",1," 6:  5O8532  D9 B9 L9 M9 V9       /MAD 4 CDG 3 0955   1155   0/735         2:00")
scr("3",1," 7   AF1114  C9 Z2 Y9 S9 K9 H9 T9 /MAD 4 CDG 3 0955   1155   0/320         2:00")
scr("3",1,"             Q9 V9 X9 GR                                                       ")
scr("3",1," 8   IB3742  C9 Y9 L9 W9 K9 Q9 T9  MAD 1 CDG 3 2100   2305   0/757         2:05")
scr("3",2,"The heading identifies the display as a GDS availability display. The")
scr("3",2,"code AN^ indicates that neutral availability is displayed. The number of ")
scr("3",2,"days between the current date and the departure date is also shown. The ")
scr("3",2,"flights in this display will depart 272 days after the current date. The ")
scr("3",2,"heading also shows the day of the week and the departure date. The 4 digits")
scr("3",2,"on the end of the heading indicate the departure time. GDS will display ")
scr("3",2,"the first flights departing within 1 hour of this time. If no departure time")
scr("3",2,"is specified, 0000 is assumed. ")
scr("3",2,"<PgDn>")
scr("3",4,"Press PgDn to proceed.")
scr("3",5,"PD")
scr("4",2,"Each flight has a line number. The carrier code and flight number are shown")
scr("4",2,"after the line number. In this example, the flight in line 1 is Iberia 3402,")
scr("4",2,"and the flight in line 5 is Air France 8614. The colon (:) in line 6 indicates")
scr("4",2,"a duplicate flight listing operated under multiple airline codes. In this")
scr("4",2,"example, 5O 8532 is the same flight as AF 1114.")
scr("4",2,"<PgDn>")
scr("4",4,"Press PgDn to proceed.")
scr("4",5,"PD")
scr("4",77,"01011112")
scr("5",2,"The columns to the right of the flight number show the number of seats that")
scr("5",2,"may be sold in one transaction with immediate confirmation. This information")
scr("5",2,"is called the seat quota. The maximum number of seats shown in each class")
scr("5",2,"depends on the carrier's agreement with GDS. On these flights, up to 9")
scr("5",2,"seats may be confirmed immediately in one transaction. A slash after the")
scr("5",2,"seat quota indicates that last-seat availability is displayed. This code is")")
scr("5",2,"called the dynamic availability indicator.")
scr("5",2,"<PgDn>")
scr("5",5,"PD")
scr("5",77,"01131133")
scr("6",2,"The next columns show the airport and terminal where each flight departs.")
scr("6",2,"The fight in line 1 departs from Madrid from terminal 4, whereas the flight")
scr("6",2,"in line 8 departs from Madrid from terminal 1.")
scr("6",2,"<PgDn>  ")
scr("6",4,"Press PgDn to proceed.")
scr("6",77,"01341139")
scr("6",5,"PD")
scr("7",2,"The next column shows the airport and terminal where each flight arrives.")
scr("7",2,"The flight in line 1 arrives at Orly at the terminal 1.")
scr("7",2,"<PgDn>  ")
scr("7",4,"Press PgDn to proceed.")
scr("7",77,"01401145")
scr("7",5,"PD")
scr("8",2,"The departure time and arrival time are shown after the off point. The")
scr("8",2,"flight in line 1 departs at 0750 and arrives at 0950. The local time is")
scr("8",2,"displayed for each point.")
scr("8",2,"<PgDn>  ")
scr("8",4,"Press PgDn to proceed.")
scr("8",77,"01461157")
scr("8",5,"PD")
scr("9",2,"The number of stops and the equipment code are displayed after the flight")
scr("9",2,"times. The slash (/) after the number of stops indicates that the carrier")
scr("9",2,"is a Full Access carrier. All the flights in this example are nonstop.")
scr("9",2,"<PgDn>  ")
scr("9",4,"Press PgDn to proceed.")
scr("9",77,"01611165")
scr("9",5,"PD")
scr("10",2,"The access indicator may be one of the following:")
scr("10",2," ")
scr("10",2,"                        /^          Full Access ")
scr("10",2,"                        .^          Access Sell ")
scr("10",2,"                        :^          Access Update ")
scr("10",2,"                        *^          Direct Access ")
scr("10",2,"   ")
scr("10",2,"<PgDn>")
scr("10",4,"Press PgDn to proceed.")
scr("10",5,"PD")
scr("11",2,"A slash (/) means update and sell together: number of seats fully synchronized")
scr("11",2,"in each class, up to 9 seats per class and if a reservation is booked, it will ")
scr("11",2,"be confirmed immediately by the airline. A dot (.) indicates that the actual")
scr("11",2,"number of available seats is not displayed. However, if a reservation is")
scr("11",2,"booked, it will be confirmed immediately. ")
scr("11",2,"<PgDn>")
scr("11",4,"Press PgDn to proceed.")
scr("11",5,"PD")
scr("12",2,"A colon (:) indicates that the display is synchronized with the")
scr("12",2,"airline's reservation system. If a reservation is booked, a message will")
scr("12",2,"be sent notifying the airline. An asterisk (*) indicates that the actual")
scr("12",2,"number of available seats can be obtained from the airline by means of")
scr("12",2,"a special direct-access entry.")
scr("12",2,"<PgDn>")
scr("12",4,"Press PgDn to proceed.")
scr("12",5,"PD")
scr("13",2,"Which code indicates that the actual number of available seats")
scr("13",2,"is not displayed and booked reservations will be confirmed immediately?")
scr("13",5,".")
scr("14",2,"The equipment code is displayed to the right of the GDS Access")
scr("14",2,"indicator. The flight in line 1 is operated with Airbus A320 aircraft.")
scr("14",2,"<PgDn>  ")
scr("14",4,"Press PgDn to proceed.")
scr("14",77,"01631165")
scr("14",5,"PD")
scr("15",2,"The total elapsed flight time is displayed on the right. The flight in")
scr("15",2,"line 8 has an elapsed time of 2 hours, 5 minutes.")
scr("15",2,"<PgDn>  ")
scr("15",4,"Press PgDn to proceed.")
scr("15",77,"01751179")
scr("15",5,"PD")
scr("16",2," Assume a client plans to travel on 12 April from Munich to Moscu.")
scr("16",2," Display neutral availability. ")
scr("16",5,"AN12APRMUCMOW")
