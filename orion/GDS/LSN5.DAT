scr("0",22,"          SELLING FROM AVAILABILITY")
scr("0",2," After finishing this lesson, you will be able to...")
scr("0",2," ")
scr("0",2,"        [ sell air segments from a flight availability display.")
scr("0",2,"        [ sell connecting flights in the same class.")
scr("0",2,"        [ sell connecting flights in different classes.")
scr("0",2,"<PgDn>")
scr("0",5,"PD")
scr("1",2,"The entry code SS^ is used to book an air segment from an availability display,")
scr("1",2,"as follows: ")
scr("1",2,"                               SS2C4^")
scr("1",2,"                      Seats~~~~~~{!!")
scr("1",2,"                      Class~~~~~~~{}~~~~~~~Line")
scr("1",2," ")
scr("1",2,"This entry will sell 2 seats in C class on the flight in line 4 of the display.")
scr("1",2,"To demonstrate, display neutral availability on 26 August from Rome to London.") 
scr("1",5,"AN26AUGROMLON")
scr("2",1," ** GDS AVAILABILITY - AN **           287 TH 26AUG 1000")
scr("2",1," 1   RK 402  C4 Y7 M7 L7 VR        CIA   STN   1255   1615   0*320       2:20")
scr("2",1," 2:  RK4749  D9 M9 L9 B9 K9 Q9 V9  CIA   STN   1330   1645   0/320       2:15")
scr("2",1," 3   EW8611  Y9 K9 Q9 T9 V9        CIA   STN   1330   1645   0/320       2:15")
scr("2",1," 4   RK 315  C9 Y0                 CIA 1 STN 1 1415   1740   0/M80       2:25")
scr("2",1," 5   FR9633  D9 M9 L9 B9 K9 Q9 V9  CIA 1 BLL 1 1730   2000   0/320           ")
scr("2",1,"     FR5179  C4 Y7 M7 L7 VR        BLL 1 STN 1 2235   2310   0*737       6:40")
scr("2",1," 6   IB3237  C4 Y7 M7 L7 V7        FCO 3 MAD 4 1930   2210   0*320           ")
scr("2",1,"     IB3162  Y9 K9 Q9 T9 V9        MAD 4 LHR 5 0815+1 0940+1 0/100      15:10")
scr("2",1," 7   FR1313  D9 M9 L9 B9 K9 Q9 V9  FCO   VIE   2030   2210   0/100           ")
scr("2",1,"     W62879  Y9 K9 Q9 T9 V9        VIE 1 LTN S 1715+1 1840+1 0/320      23:10")
scr("2",2,"The following entry will book 3 seats in C class on the flight that departs")
scr("2",2,"at 1415:")
scr("2",2,"                              SS3C4^")
scr("2",2," ")
scr("2",2,"Input this entry.")
scr("2",5,"SS3C4")
scr("2",99,"ND")
scr("3",12,"RP/ROMRK2330/ROMRK2330/")
scr("3",6," RK 315 C 26AUG 4 CIASTN HK3 1415  1740 M80   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("3",2,"Each flight reservation is represented by an air segment. The digit 1")
scr("3",2,"indicates the first element of the reservation.")
scr("3",2,"<PgDn>")
scr("3",5,"PD")
scr("4",2,"The following entry will remove the reservation from the agent's work space")
scr("4",2,"without storing the information:")
scr("4",2," ")
scr("4",2,"                                IG^")
scr("4",2," ")
scr("4",2,"This action is called ignoring the transaction. Input this entry.") ")
scr("4",12,"RP/ROMRK2330/ROMRK2330/")
scr("4",6," RK 315 C 26AUG 4 CIASTN HK3 1415  1740 M80   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("4",61,"   RK 315  C  CIASTN    M80           0")
scr("4",61,"FLIGHT DEPARTS TERMINAL 1")
scr("4",5,"IG")
scr("5",1,"IGNORED")
scr("5",2,"Now display neutral availability on 28 June from Barcelona to Milan.")
scr("5",5,"AN28JUNBCNMIL")
scr("6",1," ** GDS AVAILABILITY - AN **          228 MO 28JUN 0000")
scr("6",1," 1   RK 059  C4 Y4 M4 L4 B4 W4 T4  BCN 2 BGY   0835   1000   0*M80       1:25")
scr("6",1,"             V4 K4                                                           ")
scr("6",1," 2   RK3604  C9 M9 L9 W9 K9 TR     BCN 2 BGY   1030   1200   0/757       1:30")
scr("6",1," 3   RK 943  P9 J9 Y9 M9 Q0 B0     BCN 2 BGY   1340   1515   0/743       1:35")
scr("6",1," 4   TP 061  C4                    BCN 1 LIS 1 1740   1840   0*M80           ")
scr("6",1,"     TP3606  C9 M9 L9 W9 K9 T9     LIS 1 MXP 1 2055   0035+1 0/320       6:55")
scr("6",1," 5   TP 063  C4 Y4 M4 L4 B4 W4 T4  BCN 1 LIS 1 1755   1855   0*M80           ")
scr("6",1,"             V4 K4                                                           ")
scr("6",1,"     TP3608  C9 M9 L9 W9 K9 T9     LIS 1 MXP 1 2105   0045+1 0/320       6:55")
scr("6",2,"Book 1 seat in M class on the RK flight that arrives in Milan at 1200.")
scr("6",5,"SS1M2")
scr("6",99,"ND")
scr("7",12,"RP/BCNRK0110/BCNRK0110/")
scr("7",6,"  RK3604 M 28JUN 1 BCNBGY HK1         2  1030  1200      757   0 M\n      FLIGHT DEPARTS TERMINAL 2")
scr("7",61,"   RK3604  M  BCNBGY    757           0")
scr("7",2,"Input the entry to ignore the transaction.")
scr("7",5,"IG")
scr("8",1,"IGNORED")
scr("8",2,"Assume a client plans to travel on 21 June from Milan to Barcelona.")
scr("8",2,"Display neutral availability for all local airports.")
scr("8",5,"AN21JUNMILBCN")
scr("9",1," ** GDS AVAILABILITY - AN **          221 MO 21JUN 0800")
scr("9",1," 1   RK 942  P9 J9 Y9 M9 Q9 B9     BGY   BCN 2 1415   1550   0/743       1:35")
scr("9",1," 2   RK3609  C9 M9 L9 W9 K9 T9     BGY   BCN 2 0925   1100   0/320       1:35")
scr("9",1," 3   RK 058  C4 Y4 M4 L4 B4 W4 T4  BGY   BCN 2 2225   2359   0*M80       1:34")
scr("9",1,"             V4 K4                                                           ")
scr("9",1," 4   TP3605  C9 M9 L9 W9 K9 T9     MXP 1 LIS 1 1710   1900   0/757           ")
scr("9",1,"     TP 060  C4 Y4 M4 L4 B4 W4 T4  LIS 1 BCN 1 0600+1 0850+1 0*M80      15:40")
scr("9",1,"             V4 K4                                                           ")
scr("9",1," 5   TP 167  F4 J4 Y4 B4 H4 T4 VL  MXP 1 LIS 1 1700   1930   0 AB6           ")
scr("9",1,"     TP 062  C4 Y4 M4 L4 B4 W4 T4  LIS 1 BCN 1 0600+1 0900+1 0*M80      16:00")
scr("9",1,"             V4 K4                                                           ")
scr("9",1," 6   TP 007  C9 M9 L9 W9 K9 TL     BGY 2 BCN 1 1905   2040   0/320       1:35")
scr("9",2,"Assume the client prefers the TAP Air Portugal flight departing at 1905. Book")
scr("9",2,"a reservation for 4 passengers in W class.")
scr("9",5,"SS4W6")
scr("10",12,"RP/MILTP1330/MILTP1330/")
scr("10",6,"  TP 007 W 21JUN 1 BGYBCN HK4  1835  2  1905  2040      320   0 M\n      FLIGHT ARRIVES AT TERMINAL 1")
scr("10",2,"The air segment contains information about the flight reservation. The")
scr("10",2,"segment number indicates the order in the itinerary.")
scr("10",2,"<PgDn>")
scr("10",5,"PD")
scr("11",2,"Each flight segment shows the airline code, flight number, and class. This")
scr("11",2,"reservation is booked on TAP Air Portugal flight 007 in W class.")
scr("11",2,"<PgDn>")
scr("11",77,"01020113")
scr("11",5,"PD")
scr("12",2,"The departure date is shown after the booking class. This reservation is")
scr("12",2,"booked for 21 June. The digit after the date indicates the day of the week.")
scr("12",2,"The digit 1 indicates that the flight departs on Monday.")
scr("12",2,"<PgDn>")
scr("12",77,"01140121")
scr("12",5,"PD")
scr("13",2,"The board point and off point are displayed after the date. This flight")
scr("13",2,"departs from Milan (Bergamo/Orio al Serio) and arrives at Barcelona.")
scr("13",2,"<PgDn>")
scr("13",77,"01230128")
scr("13",5,"PD")
scr("14",2,"The segment status is displayed before the number of seats. The status code HK^")
scr("14",2,"indicates that the reservation is confirmed.")
scr("14",2,"<PgDn>")
scr("14",77,"01300132")
scr("14",5,"PD")
scr("15",2,"The local departure time and arrival time are displayed after the number of")
scr("15",2,"seats. This flight will depart from Milan at 1905 and arrive at Barcelona")
scr("15",2,"at 2040.")
scr("15",2,"<PgDn>")
scr("15",77,"01440154")
scr("15",5,"PD")
scr("16",2,"In this TP Air Portugal segment, the latest check-in time and the departure")
scr("16",2,"terminal are shown before the departure time. Passengers are advised to")
scr("16",2,"check in no later than 1835 at terminal 2.")
scr("16",2,"<PgDn>")
scr("16",77,"01350142")
scr("16",5,"PD")
scr("17",2,"The equipment code, number of stops, and meal code are displayed after")
scr("17",2,"the flight times.")
scr("17",2,"<PgDn>")
scr("17",77,"01600170")
scr("17",5,"PD")
scr("18",6,"  TP 007 W 21JUN 1 BGYBCN HK4  1835  2  1905  2040      320   0 M\n FLIGHT ARRIVES AT TERMINAL 1")
scr("18",61,"   TP 007  W  BGYBCN    320           0")
scr("18",61,"FLIGHT ARRIVES TERMINAL 1")
scr("18",2,"Any applicable service information is displayed on the line directly below")
scr("18",2,"the air segment. In this example, TP  007 will arrive at Terminal 1. Input")
scr("18",2,"the entry to ignore the transaction.")
scr("18",77,"02010250")
scr("18",5,"IG")
