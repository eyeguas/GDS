scr("4",2,"Each PNR has a history element, containing information about the PNR's")
scr("4",2,"creation and modification. The following entry is used to display the ")
scr("4",2,"history element:")
scr("4",2,"  ")
scr("4",2,"                                  RH^ ")
scr("4",2,"  ")
scr("4",2,"Input this entry now.")
