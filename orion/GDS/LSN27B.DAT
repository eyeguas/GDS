scr("7",1,"       0       1            2  ")
scr("7",2,"The row numbers are displayed across the top, and the seat letters are ")
scr("7",2,"displayed in a column on the left. Each digit of the row number is shown")
scr("7",2,"on a separate line. This displays shows rows 1 through 21. Each row on this")
scr("7",2,"aircraft has 6 seats, from A to F. A dot (.) indicates an available seat,")
scr("7",2,"and a plus (+) indicates an occupied seat. A slash (/) indicates a ")
scr("7",2,"restricted seat. In this example, seat 1F is available, but seat 10F is ")
scr("7",2,"occupied. Seat 16F is restricted and may not be assigned. ")
scr("7",2,"<PgDn>")
scr("7",5,"PD")
scr("8",2,"The top and bottom rows are window seats, whereas the middle rows are aisle")
scr("8",2,"seats. In this display, the seats lettered A and F are window seats, whereas")
scr("8",2,"the seats lettered C and D are aisle seats. The code L^ indicates a lavatory")
scr("8",2,"and K^ indicates a galley. ")
scr("8",2,"<PgDn>")
scr("8",5,"PD")
scr("9",2,"The following codes may appear in a seat map display:")
scr("9",2," ")
scr("9",2,"        /^   Restricted                   B^   Bulkhead")
scr("9",2,"        C^   Crib                         E^   Exit")
scr("9",2,"        H^   Handicapped                  I^   Infant")
scr("9",2,"        U^   Unaccompanied minor          UP^  Upper deck")
scr("9",2,"        X^   Blocked                      Z^   No view of movie screen")
scr("9",2," ")
scr("9",2,"Which code indicates a seat that may be assigned to an infant?")
scr("9",5,"I")
