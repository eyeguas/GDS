scr("6",1,"** LH/UA/TG RTW  PEX AND IT FARES - SEE FQN LH/0448/0449 *       ")
scr("6",1,"LN FARE BASIS    OW   EUR  RT   B PEN  DATES/DAYS   AP MIN MAX R ")
