scr("9",2,"The following entry will display fares of a specific airline, with no YY")
scr("9",2,"fares: ")
scr("9",2,"                            FQDMADMEX/24APR/A-IB^")
scr("9",2," ")
scr("9",2,"This entry will display only Iberia fares from MAD to MEX on 24 April. Note")
scr("9",2,"that /A-^ is typed before the airline code. What entry would be used to")
scr("9",2,"display only United Airlines fares from Los Angeles to London on 18 January,")
scr("9",2,"with no YY fares?")
scr("9",5,"FQDLAXLON/18JAN/A-UA")
scr("9",5,"FQDLAXLON/D18JAN/A-UA")
scr("10",2,"A booking class can be specified as follows:")
scr("10",2," ")
scr("10",2,"                           FQDPARROM/24MAR/CK^")
scr("10",2," ")
scr("10",2,"This entry will display only fares for travel in K class from PAR to ROM on")
scr("10",2,"24 March. Note that /C^ is typed before the booking code. What entry would")
scr("10",2,"display only fares for travel in B class from Miami to London on 17 August?")
scr("10",5,"FQDMIALON/17AUG/CB")
scr("10",5,"FQDMIALON/D17AUG/CB")
