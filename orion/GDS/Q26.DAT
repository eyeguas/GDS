scr("0",2,"1. Make the entry to input an agency commission of 9 percent. ")
scr("0",5,"FM9")
scr("0",5,"FM9.00")
scr("1",2,"2. Make the entry to store the text NON REFUNDABLE to be printed in the ")
scr("1",2,"   endorsements/restrictions box on the ticket.")
scr("1",5,"FENON REFUNDABLE")
scr("1",5,"FENONREFUNDABLE")
scr("1",5,"FENON REFUNDABLE")
scr("1",5,"FENOT REFUNDABLE")
scr("1",5,"FENONREF")
scr("1",5,"FENO REFUND")
