scr("14",2,"A specific fare type can be requested as follows:")
scr("14",2," ")
scr("14",2,"                           FQDMADBRU/18SEP/R,-SPL^")
scr("14",2," ")
scr("14",2,"This entry will display only special fares (SPL). Note that /R,-^ is typed")
scr("14",2,"before the fare request. What entry would display only special fares from")
scr("14",2,"New York City to Paris for departure on 22 May?")
scr("14",5,"FQDNYCPAR/22MAY/R,-SPL")
scr("14",5,"FQDNYCPAR/D22MAY/R,-SPL")
scr("14",5,"FQDNYCPAR/22MAY/R,RQ-SPL")
scr("14",5,"FQDNYCPAR/D22MAY/R,RQ-SPL")
