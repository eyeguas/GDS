scr("0",2,"To send an OSI message to all the carriers in the itinerary, type the code YY^")
scr("0",2,"instead of the airline code. Assume this passenger is elderly. Input an OSI")
scr("0",2,"entry for all the carriers in the itinerary.")
scr("0",11,"RP/FRALH2330/FRALH2330          0999ZZ 23AUG /1012Z   CBG9PE")
scr("0",8,"TABORRI/CARLO MR")
scr("0",6,"  LH3615 V 17SEP 5 LINFRA HK1          0730  0845   *1A/")
scr("0",6,"  SN 412 M 20SEP 1 FRABRU HK1          1040  1140   *1A/")
scr("0",6,"AP MIL 02 74657734-B")
scr("0",6,"AP MIL 02 46528875-H")
scr("0",6,"TK TL02SEP/FRALH2330")   
scr("0",5,"OSYY ELDERLY PSGR")
scr("0",5,"OSYY ELDERLY PSGR/P1")
scr("1",2,"Assume the passenger requested the reservation. Input the received-from")
scr("1",2,"element and end the transaction with one entry.")
scr("1",11,"RP/FRALH2330/FRALH2330          0999ZZ 23AUG /1012Z   CBG9PE")
scr("1",8,"TABORRI/CARLO MR")
scr("1",6,"  LH3615 V 17SEP 5 LINFRA HK1          0730  0845   *1A/")
