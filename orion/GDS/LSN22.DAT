scr("7",5,"FQDLHRJNB/D30AUG/A-SA,BA")
scr("8",2,"What entry would be used to display fares for travel on 16 June from")
scr("8",2,"San Francisco to Amsterdam, requesting fares of KLM and United Airlines?")
scr("8",5,"FQDSFOAMS/16JUN/AKL,UA")
scr("8",5,"FQDSFOAMS/16JUN/AUA,KL")
