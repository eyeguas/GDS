scr("6",2,"The transaction code FQC is used to convert a currency, as follows:")
scr("6",2," ")
scr("6",2,"                            FQC1420.00EUR/JPY^")
scr("6",2," ")
scr("6",2,"This example above will convert 1420.00 from EUR to JPY based on the bank")
scr("6",2,"selling rate. Input the entry to convert 1768.00 from CHF to JPY.")
scr("6",5,"FQC1768.00CHF/JPY")
scr("6",5,"FQC1768CHF/JPY")
