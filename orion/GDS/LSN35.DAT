scr("3",1,"    *ACCEPTED*CF- 903A002319*RATE-125.00USD")
scr("3",1,"    THANK YOU FOR CHOOSING BEST WESTERN")
scr("3",1,"  5 AP MAD 01 320 1887-B")
scr("3",1,"  6 TKTL23AUG/MADIB2332")
scr("3",2,"Whenever a PNR is changed, the received-from information must be input.")
scr("3",2,"Assume Mr. Mueller requested the change. Input the received-from element and")
scr("3",2,"end the transaction with one entry.")
scr("3",11,"RP/MADIB2332/MADIB2332          9999ZS 10AUG /1011Z    C2GR7F")
scr("3",8,"MUELLER/WOLFGANG MR  2.MUELLER/GRETTA MRS")
scr("3",6,"  3   IB3502 Y 24AUG 3 MADFRA HK2         I  1600  1835  *1A/")
scr("3",6,"  4 HHL BW HK1 FRA IN24AUG OUT29AUG 1A1DRAC EUR90.00 023")
scr("3",6,"    BEST WESTERN IMPERIAL HOTEL/BS-0099999/CF-903A002319")
scr("3",6,"    **** BEST WESTERN ****")
scr("3",6,"    *ACCEPTED*CF- 903A002319*RATE-125.00USD")
scr("3",6,"    THANK YOU FOR CHOOSING BEST WESTERN")
scr("3",6,"  5 AP MAD 01 320 1887-B")
scr("3",6,"  6 TKTL23AUG/MADIB2332")
scr("3",5,"RFP;ET")
scr("4",1,"END OF TRANSACTION COMPLETE - C2GR7F")
scr("4",2,"The following entries may be used to modify the check-in or check-out date:")
scr("4",2," ")
scr("4",2,"         5/DT-10SEP^                   Change check-in date")
scr("4",2,"         5/DD-24SEP^                   Change check-out date")
scr("4",2," ")
scr("4",2,"The option code DT-^ is used to change the check-in date. DD-^ is used to ")
scr("4",2,"change just the check-out date. What entry would be used to change the")
scr("4",2,"check-out date in segment 8 to 29 April?")
scr("4",5,"8/DD-29APR")
scr("5",2,"Retrieve the PNR for the record locator D9FR2D.")
scr("5",5,"RTD9FR2D")
