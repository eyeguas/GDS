scr("2",1,"  1.MORETTI/GINO MR    2.MORETTI/GINA MRS   3.MORETTI/PAULO (CHD)")
scr("2",1,"  4  AZ 477 Y 18JUL 2 MUCFCO HK3         0835 1000")
scr("2",1,"  5 AP ROM 354 2761-H")
