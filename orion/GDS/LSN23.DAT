scr("11",1,"             ******  SELECT PARAGRAPHS  ******  ")
scr("11",2,"If the fare notes are more than 6 pages in length, a menu of applicable ")
scr("11",2,"topics is displayed. The topics may vary, but each topic always has the ")
scr("11",2,"same paragraph number. For example, the rule pertaining to stopovers is ")
scr("11",2,"always paragraph 11, and the rule pertaining to ticketing is always ")
scr("11",2,"paragraph 18. ")
scr("11",2,"<PgDn>")
scr("11",5,"PD")
scr("12",2,"The following entry may be used to display a selected paragraph:")
scr("12",2," ")
scr("12",2,"                                 FQN4*11^")
scr("12",2," ")
scr("12",2,"This entry will display paragraph 11 for the fare in line 4. Note that an")
scr("12",2,"asterisk (*) is typed before the paragraph number. What entry would be used")
scr("12",2,"to display paragraph 19 for the fare in line 4?")
scr("12",5,"FQN4*19")
scr("12",5,"FQN4//19")
scr("13",2,"What entry would be used to display paragraph 13 for the fare in line 2 of ")
scr("13",2,"a fare display?")
scr("13",5,"FQN2*13")
scr("13",5,"FQN2//13")
