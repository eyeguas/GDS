scr("11",5,"ABL DIAZ,6 LUCAS STREET,LONDON SW74LH")
scr("11",5,"ABMR L DIAZ, 6 LUCAS STREET, LONDON SW7 4LH")
scr("11",5,"ABMR L DIAZ, 6 LUCAS STREET, LONDON SW74LH")
scr("11",5,"ABL DIAZ, 6 LUCAS STREET, LONDON SW7 4LH")
scr("11",5,"ABL DIAZ, 6 LUCAS STREET, LONDON SW74LH")
scr("12",2,"Ignore the transaction.")
scr("12",5,"IG")
scr("13",1,"IGNORED")
scr("13",2,"Input the name entry for Mr. C. Bryant.")
scr("13",5,"NM1BRYANT/CMR")
scr("13",5,"NM1BRYANT/C MR")
scr("13",5,"NM1BRYANT/C")
