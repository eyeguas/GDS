scr("0",22,"          WAITLISTED AND ARNK SEGMENTS")
scr("0",2," After finishing this lesson, you will be able to...")
scr("0",2," ")
scr("0",2,"           [ place a request for seats on a carrier's waitlist.")
scr("0",2,"           [ input a manual waitlisted segment.")
scr("0",2,"           [ enter a surface (ARNK) segment for continuity. ")
scr("0",2,"<PgDn>")
scr("0",5,"PD")
scr("1",2,"If a desired booking class is sold out, but the waitlist is open, seats may")
scr("1",2,"be placed on the carrier's waitlist for that flight. The availability status")
scr("1",2,"code L^ indicates that seats may be waitlisted. To demonstrate, display")
scr("1",2,"neutral availability on 9th February from Munich to Nice departing at 0900.")
scr("1",5,"AN9FEBMUCNCE0900")
scr("1",5,"AN9FEBMUCNCE900A")
scr("2",1,"** GDS AVAILABILITY - AN **          112 TU 9FEB 0900")
scr("2",1," 1   LH2272  C9 Z9 V9 L9 H9 BL GL  MUC 1 NCE 1 1735   1905   0/314       1:30")
scr("2",1,"             K9 QL WL ML                                                     ")
scr("2",1," 2   LH2274  C9 Z2 YL SL KL HL TL  MUC   NCE 1 2055   2225   0/AB3       1:30")
scr("2",1,"             QL VL XL GL                                                     ")
scr("2",1," 3   VY1813  C9 Z2 YL SL KL HL TL  MUC 1 BCN 1 0950   1200   0/735           ")
scr("2",1,"             QL VL XL GL                                                     ")
scr("2",1,"     VY1517  C9 Z9 V9 L9 H9 B9 G9  BCN 1 NCE 1 1625   1745   0/314       7:55")
scr("2",1,"             K9 Q9 WL ML                                                     ")
scr("2",1," 4   TP 557  C9 Z2 Y9 S9 K9 H9 T9  MUC   LIS   1250   1505   0/733           ")
scr("2",1,"             Q9 V8 X8 GR                                                     ")
scr("2",1,"     TP 486  C9 Z9 V9 L9 H9 B9 G9  LIS   NCE   2010   2340   0/314      10:50")
scr("2",1,"             K9 Q9 W9 M9                                                     ")
scr("2",2,"Assume the clients prefer the Lufthansa flight departing at 2055. The")
scr("2",2,"availability status L^ indicates seats may be waitlisted in K class. The")
scr("2",2,"code PE^ is used to book a waitlisted segment, as follows:")
scr("2",2," ")
scr("2",2,"                               SS1K2/PE^")
scr("2",2," ")
scr("2",2,"This entry will waitlist 1 seat in K class on the flight in line 2. Input")
scr("2",2,"this entry.")
scr("2",5,"SS1K2/PE")
scr("2",99,"ND")
scr("3",12,"RP/MUCLH1130/MUCLH1130/")
scr("3",6,"  LH2274 K 9FEB 2 MUCNCE HL1    2025 2  2055  2225   AB3   0 S\n      FLIGHT ARRIVES TERMINAL 1")
scr("3",61,"   LH2274  K  MUCNCE    AB3           0")
scr("3",61,"FLIGHT ARRIVES TERMINAL 1")
scr("3",2,"The status HL^ indicates a waitlisted flight segment. An alternative")
scr("3",2,"reservation should be booked to ensure that the passenger has a confirmed")
scr("3",2,"booking for his departure. Input MPAN^ to redisplay the availability")
scr("3",2,"display. Then book 1 seat in K class on the flight in line 1.")
scr("3",5,"SS1K1")
scr("4",12,"RP/MUCLH1130/MUCLH1130/")
scr("4",6,"  LH2274 K 9FEB 2 MUCNCE HL1    2025 2  2055  2225   AB3   0 S\n      FLIGHT ARRIVES TERMINAL 1")
scr("4",6,"  LH2272 K 9FEB 2 MUCNCE HK1    1705 2  1735  1905   733   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("4",61,"   LH2274  K  MUCNCE    AB3           0")
scr("4",61,"FLIGHT ARRIVES TERMINAL 1")
scr("4",61,"   LH2272  K  MUCNCE    733           0")
scr("4",61,"FLIGHT ARRIVES TERMINAL 1")
scr("4",2,"The passenger is now waitlisted on LH 2274 and confirmed on LH 2272. If the")
scr("4",2,"waitlisted segment is confirmed later, you would then cancel the duplicate")
scr("4",2,"reservation. Ignore the transaction.")
scr("4",5,"IG")
scr("5",1,"IGNORED")
scr("5",2,"Display neutral availability on 2nd May from Manchester to Warsaw,")
scr("5",2,"departing at 1100.")
scr("5",5,"AN2MAYMANWAW1100")
scr("5",5,"AN2MAYMANWAW11A")
scr("5",5,"AN2MAYMANwAW1100A")
scr("6",1,"** GDS AVAILABILITY - AN **          215 SU 2MAY 1100")
scr("6",1," 1   RK2666  C0 Y4 B4 M4 H4 Q4 SL  MAN   WMI 1 1215   1545   0.M87       2:30")
scr("6",1," 2   RR 531  C9 S0 M0 B0 H0 V0 S3  MAN   WMI 1 1315   1645   0/M87       2:30")
scr("6",1,"             G0 L0                                                           ")
scr("6",1," 3   FR3218  C9 D0 S0 B0 M0 L0 Q0  MAN   BGY   1410   1720   0/737           ")
scr("6",1,"             V0                                                              ")
scr("6",1,"     FR3898  C0 Y0 B0 M0 H0 Q0 V0  BGY   WMI   2035   2240   0.M81       7:30")
scr("6",1," 4   SN2178  C9 S9 M9 B9 H9 V9 Q9  MAN   BRU   1730   1950   0/M80           ")
scr("6",1,"             G9 L0                                                           ")
scr("6",1,"     SN2559  C9 S9 M9              BRU   WAW   2100   2300   0/D95       4:30")
scr("6",2,"Assume the passengers prefer the RK flight departing at 1215. Waitlist")
scr("6",2,"2 seats in S class.")
scr("6",5,"SS2S1/PE")
scr("6",99,"ND")
scr("7",12,"RP/MANRK1130/MANRK1130/")
scr("7",6,"  RK2666 S 2MAY 7 MANWMI HL2           1215  1545   M87   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("7",61,"   RK2666  S  MANWMI    M87           0")
scr("7",61,"FLIGHT ARRIVES TERMINAL 1")
scr("7",2,"Input MPAN^ to redisplay the availability display. Then book a confirmed")
scr("7",2,"reservation for 2 seats in S class on the flight in line 2.")
scr("7",5,"SS2S2")
scr("8",12,"RP/MANRK1130/MANRK1130/")
scr("8",6,"  RK2666 S 2MAY 7 MANWMI HL2           1215  1545   M87   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("8",6,"  RR 531 S 2MAY 7 MANWMI HK2           1315  1645   M87   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("8",2,"The passenger is now waitlisted on RK2666 and confirmed on RR 531. Ignore")
scr("8",2,"the transaction.")
scr("8",61,"   RK2666  S  MANWMI    M87           0")
scr("8",61,"FLIGHT ARRIVES TERMINAL 1")
scr("8",61,"   RR 531  S  MANWMI    M87           0")
scr("8",61,"FLIGHT ARRIVES TERMINAL 1")
scr("8",5,"IG")
scr("9",1,"IGNORED")
scr("9",2,"The code PE^ is used to waitlist a segment by carrier and flight number,")
scr("9",2,"as follows:")
scr("9",2," ")
scr("9",2,"                        SSAA4353S3APRDCAATLPE1^")
scr("9",2," ")
scr("9",2,"The priority waitlist code PE^ is typed before the number of seats. Study")
scr("9",2,"the example. Then input the entry to waitlist 2 seats on UA1175 in Y class")
scr("9",2,"on 22nd August from San Francisco to Honolulu.")
scr("9",5,"SSUA1175Y22AUGSFOHNLPE2")
scr("10",12,"RP/SFOUA7733/SFOUA7733/")
scr("10",6,"  UA1175 Y 22AUG 7 SFOHNL PE2            0845  1229   777   0 M")
scr("10",2,"The status code PE^ will be changed to HL^ when the transaction is ended.")
scr("10",2,"Ignore the transaction.")
scr("10",5,"IG")
scr("11",1,"IGNORED")
scr("11",2,"Input the entry to waitlist one seat on UA5694 in K class on 1st June from")
scr("11",2,"Kansas City Intl to San Francisco.")
scr("11",5,"SSUA5694K1JUNMCISFOPE1")
scr("12",12,"RP/MKCUA1130/MKCUA1130/")
scr("12",6,"  UA5694 K 1JUN 2 MCISFO PE1            0600  0755 ")
scr("12",2,"Now book a confirmed reservation on UA 775 in K class for the same date and")
scr("12",2,"city pair. Book the same number of seats.")
scr("12",5,"SSUA775K1JUNMCISFO1")
scr("12",5,"SSUA775K1JUNMCISFONN1")
scr("13",12,"RP/MKCUA1130/MKCUA1130/")
scr("13",6,"  UA5694 K 1JUN 2 MCISFO PE1            0600  0755 ")
scr("13",6,"  UA 775 K 1JUN 2 MCISFO SS1            2000  2155 ")
scr("13",2,"Ignore the transaction.")
scr("13",5,"IG")
scr("14",1,"IGNORED")
scr("14",2,"Display availability on 2nd June from Quito")
scr("14",2,"to Lima, departing at 0700.")
scr("14",5,"AN2JUNUIOLIM0700")
scr("14",5,"AN2JUNUIOLIM700A")
scr("14",5,"AN2JUNUIOLIM7A")
scr("15",1,"** GDS AVAILABILITY - AN **           209 WE 2JUN 0700")
scr("15",1," 1   LA1453  C9 Z9 V9 L9 H9 B9 G9  UIO 1 LIM 1 0917   1130   0/321       2:13")
scr("15",1,"             K9 Q9 W7 M0                                                     ")
scr("15",1," 2   LA1455  C9 Z2 Y9 S9 K9 H9 T9  UIO   LIM   2012   2225   0/AB3       2:13")
scr("15",1,"             Q9 V9 X9 GR                                                     ")
scr("15",1," 3   XL1355  C9 Z9 V9 L9 H9 B9 G9  UIO   GYE   0554   0648   0/737           ")
scr("15",1,"             K9 Q9 W9 M9                                                     ")
scr("15",1,"     LA1425  C9 Z2 Y9 S9 K6 H4 T4  GYE   LIM   0825   1025   0/735       4:31")
scr("15",1,"             Q4 V4 X4 GR                                                     ")
scr("15",1," 4   LH4413  C9 Z9 V9 L9 H9 B9 G9  UIO   GYE   2122   2216   0/314           ")
scr("15",1,"             K9 Q9 W9 M8                                                     ")
scr("15",1,"     AF1404  C9 Z2 Y9 S9 K9 H9 T9  GYE   LIM   0825+1 1025+1 0/733      13:03")
scr("15",1,"             Q9 V9 X9 GR                                                     ")
scr("15",2,"Book a confirmed reservation for one passenger in B class on the LA flight")
scr("15",2,"departing at 0917.")
scr("15",5,"SS1B1")
scr("16",12,"RP/UIOLA1111/UIOLA1111/")
scr("16",6,"  LA1453 B 2JUN 3 UIOLIM HK1    0855 1 0917  1130   321   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("16",61,"   LA1453  B  UIOLIM    321           0")
scr("16",61,"FLIGHT ARRIVES TERMINAL 1")
scr("16",2,"Assume the passenger will travel by bus from Lima to La Paz (Bolivia) and")
scr("16",2,"then board a flight to Santa Cruz (Bolivia). When the departure point")
scr("16",2,"of a flight segment is different from the arrival point of the")
scr("16",2,"preceding segment, an ARNK^ segment should be input for continuity.")
scr("16",2,"<PgDn>")
scr("16",5,"PD")
scr("17",2,"An ARNK (arrival unknown) segment is input as follows:")
scr("17",2," ")
scr("17",2,"                                 SIARNK^")
scr("17",2," ")
scr("17",2,"Input this entry.")
scr("17",5,"SIARNK")
scr("18",12,"RP/UIOLA1111/UIOLA1111/")
scr("18",6,"  LA1453 B 2JUN 3 UIOLIM HK1    0855 1 0917  1130   321   0 M\n      FLIGHT ARRIVES TERMINAL 1")
scr("18",6,"  ARNK")
scr("18",61,"   LA1453  B  UIOLIM    321           0")
scr("18",61,"FLIGHT ARRIVES TERMINAL 1")
scr("18",2,"The ARNK segment indicates that the departure point of the next flight is")
scr("18",2,"different from the arrival point of the previous flight. Display")
scr("18",2,"availability on 5th June from La Paz - El Alto ")
scr("18",2,"to Santa Cruz - El Trompillo (Bolivia) departing at 0500.")
scr("18",5,"AN5JUNLPBSRZ0500")
