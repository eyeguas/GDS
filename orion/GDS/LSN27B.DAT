scr("7",1,"  F    .+++ ...+. +++/ /. / / /")
scr("7",1,"  E    ...+ ..... ..+/ /. / / /")
scr("7",1,"  D    ..++ ..... +++/ /. / / /")
scr("7",1,"    L                           KL")
scr("7",1,"  C    .+++ ...+. +++/ /. / / /")
