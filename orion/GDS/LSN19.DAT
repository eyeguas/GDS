scr("15",6,"  5   IB4214 M 05OCT 4 BCNBRU KL1               1615  1815  *1A/")
scr("15",6,"  6 AP BRU 02 376 1232-B")
scr("15",6,"  7 TK TL25SEP/BRUSN2442")
scr("15",5,"5/HK")
scr("16",1,"RP/BRUSN2442/BRUSN2442         6464FP   19SEP /1142Z   G4CP2E")
scr("16",1,"  1.LECRIX/MICHEL MR")
scr("16",1,"  2   TP 671 S 26SEP 2 BRULIS HK1               1330  1615 ")
scr("16",1,"  3   IB 125 M 02OCT 1 LISBCN HK1               0745  0825  *1A/")
