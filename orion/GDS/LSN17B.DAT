scr("8",5,"XE3;XE6;XE10")
scr("9",2,"What entry would be used to cancel all consecutive elements from 5 through")
scr("9",2,"9? ")
scr("9",5,"XE5-9")
scr("9",5,"XE5,6,7,8,9")
scr("9",5,"XE9,8,7,6,5")
scr("10",2,"Input the entry to cancel PNR element 4.")
scr("10",5,"XE4")
scr("11",2,"What entry can be used to cancel the entire itinerary?")
scr("11",5,"XI")
scr("12",2,"Input the entry to cancel element 3 along with elements 6 through 9. ")
scr("12",5,"XE3,6-9")
scr("12",5,"XE3,6,7,8,9")
scr("12",5,"XE9,8,7,6,3")
